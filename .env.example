# eRTMAC-NWIS — Environment Configuration Template

# Backend Settings
PROJECT_NAME="eRTMAC-NWIS — Nearby Wells Intelligence System"
VERSION="1.0.0"
API_V1_STR="/api"
DEFAULT_ACTIVE_WELL_ID="OIL-W102"

# Database Configuration (SQLite default; PostgreSQL with PostGIS for production)
DATABASE_URL="sqlite:///./data/nwis_wells.db"
# DATABASE_URL="postgresql://postgres:ertmac_secret@localhost:5432/ertmac_nwis"

# Database Credentials (for Docker Compose)
DB_USER=postgres
DB_PASSWORD=ertmac_secret
DB_NAME=ertmac_nwis

# Optional External LLM Integration (falls back to deterministic RAG engine if unset)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
